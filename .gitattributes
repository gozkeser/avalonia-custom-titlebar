# Set default behavior to automatically handle line endings
* text=auto

# Source code files
*.cs text diff=csharp eol=crlf
*.axaml text eol=crlf
*.xaml text eol=crlf
*.csproj text eol=crlf
*.sln text eol=crlf
*.json text eol=crlf
*.md text eol=crlf
*.xml text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.dll binary
*.exe binary
*.pdb binary
