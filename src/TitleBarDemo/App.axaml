<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TitleBarDemo.App"
             RequestedThemeVariant="Dark">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <!-- Dark Theme Semantic Color Palette -->
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="Header.Background" Color="#18181B" />
          <SolidColorBrush x:Key="Header.Foreground" Color="#F4F4F5" />
          <SolidColorBrush x:Key="Header.Subtitle" Color="#A1A1AA" />
          <SolidColorBrush x:Key="Header.Border" Color="#27272A" />
          <SolidColorBrush x:Key="Header.Button.Hover" Color="#27272A" />
          <SolidColorBrush x:Key="Foreground.Secondary" Color="#A1A1AA" />
          <SolidColorBrush x:Key="Border.Default" Color="#3F3F46" />
          <SolidColorBrush x:Key="WindowControl.Close.Hover" Color="#DC2626" />
          <SolidColorBrush x:Key="Badge.Border" Color="#F59E0B" />
          <SolidColorBrush x:Key="Badge.Foreground" Color="#F59E0B" />
          <SolidColorBrush x:Key="Workspace.Background" Color="#09090B" />
          <SolidColorBrush x:Key="Card.Background" Color="#18181B" />
          <SolidColorBrush x:Key="Card.Border" Color="#27272A" />
          <SolidColorBrush x:Key="Search.Background" Color="#27272A" />
          <SolidColorBrush x:Key="Search.Border" Color="#3F3F46" />
          <SolidColorBrush x:Key="ToggleCard.Background" Color="#202023" />
        </ResourceDictionary>

        <!-- Light Theme Semantic Color Palette -->
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="Header.Background" Color="#F4F4F5" />
          <SolidColorBrush x:Key="Header.Foreground" Color="#18181B" />
          <SolidColorBrush x:Key="Header.Subtitle" Color="#71717A" />
          <SolidColorBrush x:Key="Header.Border" Color="#E4E4E7" />
          <SolidColorBrush x:Key="Header.Button.Hover" Color="#E4E4E7" />
          <SolidColorBrush x:Key="Foreground.Secondary" Color="#71717A" />
          <SolidColorBrush x:Key="Border.Default" Color="#D4D4D8" />
          <SolidColorBrush x:Key="WindowControl.Close.Hover" Color="#DC2626" />
          <SolidColorBrush x:Key="Badge.Border" Color="#D97706" />
          <SolidColorBrush x:Key="Badge.Foreground" Color="#D97706" />
          <SolidColorBrush x:Key="Workspace.Background" Color="#FAFAFA" />
          <SolidColorBrush x:Key="Card.Background" Color="#FFFFFF" />
          <SolidColorBrush x:Key="Card.Border" Color="#E4E4E7" />
          <SolidColorBrush x:Key="Search.Background" Color="#E4E4E7" />
          <SolidColorBrush x:Key="Search.Border" Color="#D4D4D8" />
          <SolidColorBrush x:Key="ToggleCard.Background" Color="#F4F4F5" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <!-- Column 2 Shell Layout Vector Geometries (Official 16x16 1px Codicons) -->
      <StreamGeometry x:Key="Icon.Search">M10.0195 10.7266C9.06578 11.5217 7.83875 12 6.5 12C3.46243 12 1 9.53757 1 6.5C1 3.46243 3.46243 1 6.5 1C9.53757 1 12 3.46243 12 6.5C12 7.83875 11.5217 9.06578 10.7266 10.0195L13.8535 13.1464C14.0488 13.3417 14.0488 13.6583 13.8535 13.8536C13.6583 14.0488 13.3417 14.0488 13.1464 13.8536L10.0195 10.7266ZM11 6.5C11 4.01472 8.98528 2 6.5 2C4.01472 2 2 4.01472 2 6.5C2 8.98528 4.01472 11 6.5 11C8.98528 11 11 8.98528 11 6.5Z</StreamGeometry>
      <StreamGeometry x:Key="Icon.MenuBar">M2 3.5C2 3.22 2.22 3 2.5 3H13.5C13.78 3 14 3.22 14 3.5C14 3.78 13.78 4 13.5 4H2.5C2.22 4 2 3.78 2 3.5ZM2 7.5C2 7.22 2.22 7 2.5 7H13.5C13.78 7 14 7.22 14 7.5C14 7.78 13.78 8 13.5 8H2.5C2.22 8 2 7.78 2 7.5ZM2 11.5C2 11.22 2.22 11 2.5 11H13.5C13.78 11 14 11.22 14 11.5C14 11.78 13.78 12 13.5 12H2.5C2.22 12 2 11.78 2 11.5Z</StreamGeometry>
      <StreamGeometry x:Key="Icon.SidebarLeft">M12.5 1C13.881 1 15 2.119 15 3.5V12.5C15 13.881 13.881 15 12.5 15H3.5C2.119 15 1 13.881 1 12.5V3.5C1 2.119 2.119 1 3.5 1H12.5ZM12.5 14C13.328 14 14 13.328 14 12.5V3.5C14 2.672 13.328 2 12.5 2H7V14H12.5Z</StreamGeometry>
      <StreamGeometry x:Key="Icon.PanelBottom">M15 12.5C15 13.881 13.881 15 12.5 15H3.5C2.119 15 1 13.881 1 12.5V3.5C1 2.119 2.119 1 3.5 1H12.5C13.881 1 15 2.119 15 3.5V12.5ZM2 10H14V3.5C14 2.672 13.328 2 12.5 2H3.5C2.672 2 2 2.672 2 3.5V10Z</StreamGeometry>
      <StreamGeometry x:Key="Icon.SidebarRight">M12.5 1C13.881 1 15 2.119 15 3.5V12.5C15 13.881 13.881 15 12.5 15H3.5C2.119 15 1 13.881 1 12.5V3.5C1 2.119 2.119 1 3.5 1H12.5ZM9 14V2H3.5C2.672 2 2 2.672 2 3.5V12.5C2 13.328 2.672 14 3.5 14H9Z</StreamGeometry>
      <StreamGeometry x:Key="Icon.LayoutGrid">M5.5 1C6.327 1 7 1.673 7 2.5V13.5C7 14.327 6.327 15 5.5 15H2.5C1.673 15 1 14.327 1 13.5V2.5C1 1.673 1.673 1 2.5 1H5.5ZM2.5 2C2.225 2 2 2.225 2 2.5V13.5C2 13.775 2.225 14 2.5 14H5.5C5.775 14 6 13.775 6 13.5V2.5C6 2.225 5.775 2 5.5 2H2.5ZM13.5 9C14.327 9 15 9.673 15 10.5V13.5C15 14.327 14.327 15 13.5 15H10.5C9.673 15 9 14.327 9 13.5V10.5C9 9.673 9.673 9 10.5 9H13.5ZM10.5 10C10.225 10 10 10.225 10 10.5V13.5C10 13.775 10.225 14 10.5 14H13.5C13.775 14 14 13.775 14 13.5V10.5C14 10.225 13.775 10 13.5 10H10.5ZM13.5 1C14.327 1 15 1.673 15 2.5V5.5C15 6.327 14.327 7 13.5 7H10.5C9.673 7 9 6.327 9 5.5V2.5C9 1.673 9.673 1 10.5 1H13.5ZM10.5 2C10.225 2 10 2.225 10 2.5V5.5C10 5.775 10.225 6 10.5 6H13.5C13.775 6 14 5.775 14 5.5V2.5C14 2.225 13.775 2 13.5 2H10.5Z</StreamGeometry>

      <!-- Compact & Expand Mode Toggle Vector Geometries (16x16 1px Codicons) -->
      <StreamGeometry x:Key="Icon.Layout.Compact">M11.8536 3.35355L8.35355 6.85355C8.15829 7.04882 7.84171 7.04882 7.64645 6.85355L4.14645 3.35355C3.95118 3.15829 3.95118 2.84171 4.14645 2.64645C4.34171 2.45118 4.65829 2.45118 4.85355 2.64645L8 5.79289L11.1464 2.64645C11.3417 2.45118 11.6583 2.45118 11.8536 2.64645C12.0488 2.84171 12.0488 3.15829 11.8536 3.35355ZM11.8536 12.6464L8.35355 9.14645C8.15829 8.95118 7.84171 8.95118 7.64645 9.14645L4.14645 12.6464C3.95118 12.8417 3.95118 13.1583 4.14645 13.3536C4.34171 13.5488 4.65829 13.5488 4.85355 13.3536L8 10.2071L11.1464 13.3536C11.3417 13.5488 11.6583 13.5488 11.8536 13.3536C12.0488 13.1583 12.0488 12.8417 11.8536 12.6464Z</StreamGeometry>
      <StreamGeometry x:Key="Icon.Layout.Expand">M11.854 10.146C12.049 10.341 12.049 10.658 11.854 10.853L8.35401 14.353C8.15901 14.548 7.84201 14.548 7.64701 14.353L4.14701 10.853C3.95201 10.658 3.95201 10.341 4.14701 10.146C4.34201 9.95098 4.65901 9.95098 4.85401 10.146L8.00001 13.293L11.146 10.146C11.341 9.95098 11.658 9.95098 11.853 10.146H11.854ZM4.85401 5.85398L8.00001 2.70798L11.146 5.85398C11.341 6.04898 11.658 6.04898 11.853 5.85398C12.048 5.65898 12.048 5.34198 11.853 5.14698L8.35301 1.64698C8.15801 1.45198 7.84101 1.45198 7.64601 1.64698L4.14601 5.14698C3.95101 5.34198 3.95101 5.65898 4.14601 5.85398C4.34101 6.04898 4.65901 6.04898 4.85401 5.85398Z</StreamGeometry>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <!-- General Header Button Styles -->
    <Style Selector="Button.header-btn">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource Foreground.Secondary}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Padding" Value="7,3" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.header-btn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Header.Button.Hover}" />
      <Setter Property="Foreground" Value="{DynamicResource Header.Foreground}" />
    </Style>

    <!-- Layout Toggle Icon Button Styles (VS Code Style) -->
    <Style Selector="Button.header-layout-icon-btn">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource Foreground.Secondary}" />
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="22" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.header-layout-icon-btn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Header.Button.Hover}" />
      <Setter Property="Foreground" Value="{DynamicResource Header.Foreground}" />
    </Style>
  </Application.Styles>
</Application>